# pdf environment. Copy to pdf.env (chmod 600). Nothing secret here:
# the app stores nothing and has no login; a PDF is edited in the visitor's browser only.
# required:
# (no owner secret is needed)

# --- deployment ---
# The only line hosh-deploy changes (one release tag per deploy).
APP_IMAGE='ghcr.io/pazka/pdf:v0.1.0'
APP_BIND='127.0.0.1:9143'

# --- app ---
APP_LOG_LEVEL='info'
